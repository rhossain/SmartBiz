{
  "name": "smartbiz-bd",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "bun scripts/build.ts",
    "serve": "bun src/server/main.ts",
    "start": "bun scripts/start.ts",
    "seed:demo": "bun scripts/seed-demo.ts",
    "migrate": "bun --env-file=.env.migrate src/db/migrate.ts",
    "test": "bun test tests/unit tests/integration tests/import-all.test.ts",
    "test:realdb": "bun test tests/realdb",
    "test:e2e": "bun tests/e2e/wiring-check.ts",
    "bench": "bun tests/perf/order-api.bench.ts",
    "lint": "eslint .",
    "format": "prettier --check src tests scripts",
    "type-check": "tsc --noEmit",
    "coverage": "bun test tests/unit tests/integration tests/import-all.test.ts --coverage --coverage-reporter=text",
    "check:coverage": "bun scripts/check-coverage.ts",
    "check:bundle": "bun scripts/check-bundle.ts",
    "check:secrets": "bun scripts/secret-scan.ts",
    "mutants": "bun scripts/mutants.ts",
    "smoke": "bun scripts/smoke.ts",
    "gate": "bun scripts/gate.ts",
    "logs:summary": "bun scripts/log-summary.ts",
    "reset-password": "bun --env-file=.env scripts/reset-password.ts"
  },
  "dependencies": {
    "argon2": "0.40.3",
    "postgres": "3.4.9",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testing-library/react": "14.3.1",
    "@types/bun": "1.4.3",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "8.57.1",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "4.6.2",
    "happy-dom": "21.0.4",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vite": "6.4.5"
  }
}
