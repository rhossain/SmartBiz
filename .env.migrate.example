# .env.migrate.example — copy to .env.migrate (gitignored). Never loaded by the server:
# only `bun run migrate` (bun --env-file=.env.migrate) and
# `docker compose --env-file .env.migrate up -d` read it. The server refuses to start if
# MIGRATE_DATABASE_URL is in its environment.
MIGRATE_DATABASE_URL=postgres://postgres:<POSTGRES_PASSWORD>@127.0.0.1:5432/smartbiz
# Used by the postgres container on first start (db/init/01-roles.sh).
POSTGRES_PASSWORD=<choose a long random password>
SMARTBIZ_APP_PASSWORD=<choose another long random password>
SMARTBIZ_DB_PORT=5432
