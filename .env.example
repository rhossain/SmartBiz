# .env.example — copy to .env (gitignored). bun loads .env for the server by itself.
# The server connects as smartbiz_app, a login member of app_role — never as postgres.
PORT=3000
DATABASE_URL=postgres://smartbiz_app:<SMARTBIZ_APP_PASSWORD>@127.0.0.1:5432/smartbiz
# Host port of the compose database (docker-compose.yml); keep it equal to the port above.
SMARTBIZ_DB_PORT=5432
# Optional, not a secret: where the gate's real-browser check (scripts/browser-check.ts, step
# 14b) finds Google Chrome. It is read from your shell, not from this file; the default is the
# macOS path below. Without a Chrome there the gate says "browser: not run (no Chrome)".
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
