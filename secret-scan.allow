# secret-scan.allow — committed exceptions for scripts/secret-scan.ts.
# Format: <path glob> <pattern id>  # reason (a line without a reason fails the scan)
#
# Keep entries narrow: one path (or one tree of fixtures) and one pattern id each.

.github/workflows/ci.yml url-password  # ci_throwaway: the CI-only password of a service container that lives for one job and guards nothing (team.md Code Style)
tests/** assigned-secret  # test fixtures: throwaway passwords for the in-memory SQL stub and per-run throwaway containers; never a real account
tests/unit/server-config.test.ts url-password  # a fake URL whose password is the literal "pw-not-printed", used to prove refusals never echo it
aidlc/spaces/default/intents/261004-mvp/construction/build-and-test/build-instructions.md url-password  # documentation example "app:app" for a local test database
aidlc/spaces/default/intents/261027-app-wiring/construction/u1-skeleton/nfr-design/security-design.md url-password  # describes the scan's own URL regex in prose, not a credential
.claude/skills/bmad-testarch-atdd/** assigned-secret  # third-party skill documentation with sample passwords in example tests
.agents/skills/bmad-testarch-atdd/** assigned-secret  # the same third-party skill documentation, mirrored for another harness
.agent/skills/bmad-testarch-atdd/** assigned-secret  # the same third-party skill documentation, mirrored for another harness
scripts/browser-check.ts assigned-secret  # throwaway Owner credentials in a per-run database
